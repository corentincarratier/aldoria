config_version=5

[application]
config/name="Aldoria V1 · Copie Godot"
config/use_custom_user_dir=true
config/custom_user_dir_name="aldoria-v1-godot"
run/main_scene="res://jeu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1150
window/size/viewport_height=760
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043,0.039,0.059,1)
